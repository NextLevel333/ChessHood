# Future ERC-20 token gate (all placeholders; nothing is live).
# Copy to .env.local and fill in once a token is launched and legal/compliance review is done.

# Master switch. Keep "false" until verification + compliance exist.
VITE_TOKEN_GATE_ENABLED=false
# EVM chain ID of the network the token lives on (placeholder; confirm before use).
VITE_TOKEN_CHAIN_ID=
# ERC-20 contract address (0x + 40 hex chars).
VITE_TOKEN_CONTRACT_ADDRESS=
# Token symbol shown in the UI.
VITE_TOKEN_SYMBOL=HOOD
# Minimum balance (human-readable units, e.g. 1000) required for gated access.
VITE_TOKEN_REQUIRED_BALANCE=0
# Token decimals (used when reading on-chain balances in the future).
VITE_TOKEN_DECIMALS=18
