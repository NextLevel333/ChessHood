# ChessHood environment template. Copy the relevant parts to the files named below.
# NEVER commit real secrets. Anything prefixed VITE_ is PUBLIC (shipped in the browser bundle).

# ───────────────────────── Frontend (public) → copy to .env.local ─────────────────────────
# Base URL of the backend HTTP API. Leave empty to show "online play unavailable".
# In `npm run dev` it defaults to http://localhost:3001.
VITE_API_URL=http://localhost:3001
# Socket.IO URL. Optional; defaults to VITE_API_URL.
VITE_SOCKET_URL=
# Vite base path for production builds. Defaults to /ChessHood/ (GitHub Pages project site).
# VITE_BASE=/ChessHood/

# ───────────────────── Backend (SERVER-ONLY) → copy to server/.env ─────────────────────
PORT=3001
# Exact browser origins allowed by CORS/Socket.IO, comma-separated. No wildcards, no paths.
# Production example: CORS_ORIGINS=https://<user>.github.io
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the server (e.g. 1 on Render/Fly/Railway) so rate limits use real client IPs.
TRUST_PROXY_HOPS=0
# Required in production (>= 32 random chars). Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Testnet-only ERC-20 research gate. DISABLED by default. ──
# Free/private play works with the gate off. No payments, wagers, prizes or mainnet use.
TESTNET_GATE_ENABLED=false
# Supported testnets: 11155111 Sepolia, 17000 Holesky, 84532 Base Sepolia, 421614 Arbitrum Sepolia,
# 11155420 OP Sepolia, 80002 Polygon Amoy, 97 BNB testnet. Known mainnets are always rejected.
TESTNET_CHAIN_ID=11155111
# Server-side RPC endpoint (may contain an API key: keep it here, never in VITE_*).
TESTNET_RPC_URL=https://your-testnet-rpc.example.invalid
# ERC-20 token contract ON THE TESTNET above.
TESTNET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_TOKEN_SYMBOL=TEST
TESTNET_TOKEN_DECIMALS=18
# Minimum balance in whole tokens (decimal string), e.g. 1 or 0.5
TESTNET_REQUIRED_BALANCE=1
# "arena" = only arena rooms need the gate; "all" = room create/join and quick match need it.
TESTNET_GATE_SCOPE=arena
# Advanced: explicitly allow another testnet chain ID not listed above (mainnets still rejected).
# TESTNET_EXTRA_CHAIN_IDS=
